// macros enconding movement or bumping into a wall
formula yu = u ? (y+1) : y;
formula yd = d ? (y-1) : y;
formula xr = r ? (x+1) : x;
formula xl = l ? (x-1) : x;

formula at_goal = (x=23 & y=20);
formula crashed = false;
label "goal" = at_goal;
label "bad" = crashed | failed | (x=8 & y=1) | (x=9 & y=1) | (x=10 & y=1) | (x=11 & y=1) | (x=12 & y=1) | (x=13 & y=1) | (x=14 & y=1) | (x=15 & y=1) | (x=18 & y=1) | (x=18 & y=2) | (x=6 & y=3) | (x=9 & y=3) | (x=17 & y=3) | (x=18 & y=3) | (x=19 & y=3) | (x=6 & y=4) | (x=9 & y=4) | (x=17 & y=4) | (x=0 & y=5) | (x=6 & y=5) | (x=9 & y=5) | (x=17 & y=5) | (x=21 & y=5) | (x=22 & y=5) | (x=23 & y=5) | (x=0 & y=6) | (x=3 & y=6) | (x=6 & y=6) | (x=9 & y=6) | (x=17 & y=6) | (x=21 & y=6) | (x=22 & y=6) | (x=23 & y=6) | (x=0 & y=7) | (x=6 & y=7) | (x=11 & y=7) | (x=12 & y=7) | (x=13 & y=7) | (x=17 & y=7) | (x=17 & y=8) | (x=1 & y=9) | (x=5 & y=9) | (x=5 & y=10) | (x=5 & y=11) | (x=1 & y=12) | (x=2 & y=12) | (x=3 & y=12) | (x=5 & y=12) | (x=16 & y=12) | (x=17 & y=12) | (x=18 & y=12) | (x=19 & y=12) | (x=20 & y=12) | (x=21 & y=12) | (x=5 & y=13) | (x=12 & y=13) | (x=13 & y=13) | (x=14 & y=13) | (x=20 & y=13) | (x=12 & y=15) | (x=13 & y=15) | (x=14 & y=15) | (x=7 & y=16) | (x=9 & y=16) | (x=21 & y=16) | (x=7 & y=17) | (x=21 & y=17) | (x=2 & y=18) | (x=3 & y=18) | (x=4 & y=18) | (x=7 & y=18) | (x=10 & y=18) | (x=11 & y=18) | (x=12 & y=18) | (x=21 & y=18) | (x=7 & y=19) | (x=21 & y=19) | (x=7 & y=20) | (x=21 & y=20);
label "fail" = crashed | failed;

module grid

  x : [0..23] init 0;
  y : [0..20] init 0;
  failed : bool init false;
  collected_9_2 : bool init false;
  collected_19_2 : bool init false;
  collected_1_5 : bool init false;
  collected_23_8 : bool init false;
  collected_2_13 : bool init false;
  collected_5_18 : bool init false;

  // actions: u - up, d - down, r - right, l - left, c - collect

  [u] (x=0 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=0 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=0 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=0 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=0 & y=0 & !failed) -> 1.0 : true;

  [u] (x=1 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=1 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=1 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=1 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=1 & y=0 & !failed) -> 1.0 : true;

  [u] (x=2 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=2 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=2 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=2 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=2 & y=0 & !failed) -> 1.0 : true;

  [u] (x=3 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=3 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=3 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=3 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=3 & y=0 & !failed) -> 1.0 : true;

  [u] (x=4 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=4 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=4 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=4 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=4 & y=0 & !failed) -> 1.0 : true;

  [u] (x=5 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=5 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=5 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=5 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=5 & y=0 & !failed) -> 1.0 : true;

  [u] (x=6 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=6 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=6 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=6 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=6 & y=0 & !failed) -> 1.0 : true;

  [u] (x=7 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=7 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=7 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=7 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=7 & y=0 & !failed) -> 1.0 : true;

  [u] (x=8 & y=0 & !failed) -> 1.0-(SLIP_PROB*2) : (y'=yu) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
  [d] (x=8 & y=0 & !failed) -> 1.0-(SLIP_PROB*2) : (y'=yd) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
  [r] (x=8 & y=0 & !failed) -> 1.0-(SLIP_PROB*2) : (x'=xr) + SLIP_PROB : (y'=yu) + SLIP_PROB : (y'=yd);
  [l] (x=8 & y=0 & !failed) -> 1.0-(SLIP_PROB*2) : (x'=xl) + SLIP_PROB : (y'=yu) + SLIP_PROB : (y'=yd);
