// Grid Prism Model Generated from Input File
// Dimensions: 7 x 7

// 6 | B B T T T T G 
// 5 | B c T T V c T 
// 4 | B B T T C V T 
// 3 | . T T b T T T 
// 2 | T T b T T T T 
// 1 | T T T T V C V 
// 0 | S T T . V V V 
// y ---------------
//   x 0 1 2 3 4 5 6 

// . : CELL, S : START, G : GOAL, + : SLIP_ALL_DIRECTIONS, T : SLIP_SIDES, R : SLIP_RIGHT, L : SLIP_LEFT, C : COLLECTIBLE, c : COLLECTIBLE_SLIP, H : HAZARDOUS_COLLECTIBLE, h : HAZARDOUS_COLLECTIBLE_SLIP, W : WEAK_SIGNAL, D : DEADZONE, F : FAILURE, B : BAD_ZONE, b : BAD_ZONE_SLIP, V : BAD_DEADZONE, I : INVISIBLE_BAD_ZONE, i : INVISIBLE_BAD_ZONE_SLIP, - : WALL


pomdp

observables
x, y, failed, collected_5_1, collected_4_4, collected_1_5, collected_5_5
endobservables

// grid dimensions
const int MAX_X = 6;
const int MIN_X = 0;
const int MAX_Y = 6;
const int MIN_Y = 0;

// slip probability
const double SLIP_PROB = 0.1;
const double WEAK_SIGNAL_PROB = 0.9;
const double DEADZONE_PROB = 0.1;
const double HAZARDOUS_COLLECTIBLE_FAILURE_PROB = 0.2;

// macros enconding whether movement in a direction is possible
formula u = (x=0 & y=0) | (x=1 & y=0) | (x=2 & y=0) | (x=3 & y=0) | (x=4 & y=0) | (x=5 & y=0) | (x=6 & y=0) | (x=0 & y=1) | (x=1 & y=1) | (x=2 & y=1) | (x=3 & y=1) | (x=4 & y=1) | (x=5 & y=1) | (x=6 & y=1) | (x=0 & y=2) | (x=1 & y=2) | (x=2 & y=2) | (x=3 & y=2) | (x=4 & y=2) | (x=5 & y=2) | (x=6 & y=2) | (x=0 & y=3) | (x=1 & y=3) | (x=2 & y=3) | (x=3 & y=3) | (x=4 & y=3) | (x=5 & y=3) | (x=6 & y=3) | (x=0 & y=4) | (x=1 & y=4) | (x=2 & y=4) | (x=3 & y=4) | (x=4 & y=4) | (x=5 & y=4) | (x=6 & y=4) | (x=0 & y=5) | (x=1 & y=5) | (x=2 & y=5) | (x=3 & y=5) | (x=4 & y=5) | (x=5 & y=5) | (x=6 & y=5);
formula d = (x=0 & y=1) | (x=1 & y=1) | (x=2 & y=1) | (x=3 & y=1) | (x=4 & y=1) | (x=5 & y=1) | (x=6 & y=1) | (x=0 & y=2) | (x=1 & y=2) | (x=2 & y=2) | (x=3 & y=2) | (x=4 & y=2) | (x=5 & y=2) | (x=6 & y=2) | (x=0 & y=3) | (x=1 & y=3) | (x=2 & y=3) | (x=3 & y=3) | (x=4 & y=3) | (x=5 & y=3) | (x=6 & y=3) | (x=0 & y=4) | (x=1 & y=4) | (x=2 & y=4) | (x=3 & y=4) | (x=4 & y=4) | (x=5 & y=4) | (x=6 & y=4) | (x=0 & y=5) | (x=1 & y=5) | (x=2 & y=5) | (x=3 & y=5) | (x=4 & y=5) | (x=5 & y=5) | (x=6 & y=5) | (x=0 & y=6) | (x=1 & y=6) | (x=2 & y=6) | (x=3 & y=6) | (x=4 & y=6) | (x=5 & y=6) | (x=6 & y=6);
formula r = (x=0 & y=0) | (x=1 & y=0) | (x=2 & y=0) | (x=3 & y=0) | (x=4 & y=0) | (x=5 & y=0) | (x=0 & y=1) | (x=1 & y=1) | (x=2 & y=1) | (x=3 & y=1) | (x=4 & y=1) | (x=5 & y=1) | (x=0 & y=2) | (x=1 & y=2) | (x=2 & y=2) | (x=3 & y=2) | (x=4 & y=2) | (x=5 & y=2) | (x=0 & y=3) | (x=1 & y=3) | (x=2 & y=3) | (x=3 & y=3) | (x=4 & y=3) | (x=5 & y=3) | (x=0 & y=4) | (x=1 & y=4) | (x=2 & y=4) | (x=3 & y=4) | (x=4 & y=4) | (x=5 & y=4) | (x=0 & y=5) | (x=1 & y=5) | (x=2 & y=5) | (x=3 & y=5) | (x=4 & y=5) | (x=5 & y=5) | (x=0 & y=6) | (x=1 & y=6) | (x=2 & y=6) | (x=3 & y=6) | (x=4 & y=6) | (x=5 & y=6);
formula l = (x=1 & y=0) | (x=2 & y=0) | (x=3 & y=0) | (x=4 & y=0) | (x=5 & y=0) | (x=6 & y=0) | (x=1 & y=1) | (x=2 & y=1) | (x=3 & y=1) | (x=4 & y=1) | (x=5 & y=1) | (x=6 & y=1) | (x=1 & y=2) | (x=2 & y=2) | (x=3 & y=2) | (x=4 & y=2) | (x=5 & y=2) | (x=6 & y=2) | (x=1 & y=3) | (x=2 & y=3) | (x=3 & y=3) | (x=4 & y=3) | (x=5 & y=3) | (x=6 & y=3) | (x=1 & y=4) | (x=2 & y=4) | (x=3 & y=4) | (x=4 & y=4) | (x=5 & y=4) | (x=6 & y=4) | (x=1 & y=5) | (x=2 & y=5) | (x=3 & y=5) | (x=4 & y=5) | (x=5 & y=5) | (x=6 & y=5) | (x=1 & y=6) | (x=2 & y=6) | (x=3 & y=6) | (x=4 & y=6) | (x=5 & y=6) | (x=6 & y=6);

// macros enconding movement or bumping into a wall
formula yu = u ? (y+1) : y;
formula yd = d ? (y-1) : y;
formula xr = r ? (x+1) : x;
formula xl = l ? (x-1) : x;

formula at_goal = (x=6 & y=6);
formula crashed = false;
label "goal" = at_goal;
label "bad" = crashed | failed | (x=4 & y=0) | (x=5 & y=0) | (x=6 & y=0) | (x=4 & y=1) | (x=6 & y=1) | (x=2 & y=2) | (x=3 & y=3) | (x=0 & y=4) | (x=1 & y=4) | (x=5 & y=4) | (x=0 & y=5) | (x=4 & y=5) | (x=0 & y=6) | (x=1 & y=6);

