  [l] (x=10 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (x'=xl) + SLIP_PROB : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xr);
  [c] (x=10 & y=7 & !failed) -> 1.0 : true;

  [u] (x=11 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
  [d] (x=11 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (y'=yd) + SLIP_PROB : (y'=yu) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
  [r] (x=11 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (x'=xr) + SLIP_PROB : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xl);
  [l] (x=11 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (x'=xl) + SLIP_PROB : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xr);
  [c] (x=11 & y=7 & !failed) -> 1.0 : true;

  // goal (12, 7): the next action ends the episode
  [u] (x=12 & y=7 & !failed & !done) -> 1.0 : (done'=true);
  [d] (x=12 & y=7 & !failed & !done) -> 1.0 : (done'=true);
  [r] (x=12 & y=7 & !failed & !done) -> 1.0 : (done'=true);
  [l] (x=12 & y=7 & !failed & !done) -> 1.0 : (done'=true);
  [c] (x=12 & y=7 & !failed & !done) -> 1.0 : (done'=true);

  [u] failed & !done -> 1.0 : (done'=true);
  [d] failed & !done -> 1.0 : (done'=true);
  [r] failed & !done -> 1.0 : (done'=true);
  [l] failed & !done -> 1.0 : (done'=true);
  [c] failed & !done -> 1.0 : (done'=true);


  [u] done -> 1.0 : true;
  [d] done -> 1.0 : true;
  [r] done -> 1.0 : true;
  [l] done -> 1.0 : true;
  [c] done -> 1.0 : true;
endmodule

