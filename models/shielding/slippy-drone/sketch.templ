  [l] (x=9 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (x'=xl) + SLIP_PROB : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xr);
  [c] (x=9 & y=7 & !failed) -> 1.0 : true;

  [u] (x=10 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
  [d] (x=10 & y=7 & !failed) -> 1.0-(SLIP_PROB*3) : (y'=yd) + SLIP_PROB : (y'=yu) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
