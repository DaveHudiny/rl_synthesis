// macros enconding movement or bumping into a wall
formula yu = u ? (y+1) : y;
formula yd = d ? (y-1) : y;
formula xr = r ? (x+1) : x;
formula xl = l ? (x-1) : x;

formula at_goal = (x=12 & y=7);
formula crashed = false;
label "goal" = at_goal;
label "bad" = crashed | failed | (x=9 & y=0) | (x=10 & y=0) | (x=11 & y=0) | (x=12 & y=0) | (x=9 & y=1) | (x=10 & y=1) | (x=11 & y=1) | (x=12 & y=1) | (x=9 & y=2) | (x=10 & y=2) | (x=11 & y=2) | (x=12 & y=2) | (x=1 & y=6) | (x=2 & y=6) | (x=0 & y=7) | (x=1 & y=7);
label "fail" = crashed | failed;

module grid

  x : [0..12] init 0;
  y : [0..7] init 0;
  failed : bool init false;
  collected_7_0 : bool init false;
  collected_12_4 : bool init false;
  collected_0_5 : bool init false;
  collected_5_7 : bool init false;

  // actions: u - up, d - down, r - right, l - left, c - collect

  [u] (x=0 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=0 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=0 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=0 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=0 & y=0 & !failed) -> 1.0 : true;

  [u] (x=1 & y=0 & !failed) -> 1.0-(SLIP_PROB*3) : (y'=yu) + SLIP_PROB : (y'=yd) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
  [d] (x=1 & y=0 & !failed) -> 1.0-(SLIP_PROB*3) : (y'=yd) + SLIP_PROB : (y'=yu) + SLIP_PROB : (x'=xr) + SLIP_PROB : (x'=xl);
