// macros enconding movement or bumping into a wall
formula yu = u ? (y+1) : y;
formula yd = d ? (y-1) : y;
formula xr = r ? (x+1) : x;
formula xl = l ? (x-1) : x;

formula at_goal = (x=20 & y=14);
formula crashed = false;
label "goal" = at_goal;
label "bad" = crashed | failed | (x=6 & y=0) | (x=9 & y=0) | (x=17 & y=0) | (x=6 & y=1) | (x=11 & y=1) | (x=12 & y=1) | (x=13 & y=1) | (x=17 & y=1) | (x=17 & y=2) | (x=1 & y=3) | (x=5 & y=3) | (x=5 & y=4) | (x=5 & y=5) | (x=1 & y=6) | (x=2 & y=6) | (x=3 & y=6) | (x=5 & y=6) | (x=16 & y=6) | (x=17 & y=6) | (x=18 & y=6) | (x=19 & y=6) | (x=20 & y=6) | (x=5 & y=7) | (x=12 & y=7) | (x=13 & y=7) | (x=14 & y=7) | (x=20 & y=7) | (x=12 & y=9) | (x=13 & y=9) | (x=14 & y=9) | (x=7 & y=10) | (x=9 & y=10) | (x=7 & y=11) | (x=2 & y=12) | (x=3 & y=12) | (x=4 & y=12) | (x=7 & y=12) | (x=10 & y=12) | (x=11 & y=12) | (x=12 & y=12) | (x=7 & y=13) | (x=7 & y=14);
label "fail" = crashed | failed;

module grid

  x : [0..20] init 0;
  y : [0..14] init 0;
  failed : bool init false;
  collected_8_1 : bool init false;
  collected_4_2 : bool init false;
  collected_12_4 : bool init false;
  collected_18_4 : bool init false;
  collected_2_7 : bool init false;
  collected_18_11 : bool init false;
  collected_5_12 : bool init false;
  collected_11_13 : bool init false;

  // actions: u - up, d - down, r - right, l - left, c - collect

  [u] (x=0 & y=0 & !failed) -> 1.0 : (y'=yu);
  [d] (x=0 & y=0 & !failed) -> 1.0 : (y'=yd);
  [r] (x=0 & y=0 & !failed) -> 1.0 : (x'=xr);
  [l] (x=0 & y=0 & !failed) -> 1.0 : (x'=xl);
  [c] (x=0 & y=0 & !failed) -> 1.0 : true;

  [u] (x=1 & y=0 & !failed) -> 1.0 : (y'=yu);
